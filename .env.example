# --- Telegram (compte dédié — jamais ton compte personnel) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNEL=@station_x
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Capital.com (compte principal, Station X + Flux B Hypothèse #1) ---
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
CAPITAL_ENVIRONMENT=demo          # demo | live — NE JAMAIS passer en live manuellement
# accountId Capital.com du compte à cibler explicitement (PUT /session) —
# JAMAIS le compte "préféré" seul, qui s'est montré instable (partagé
# entre toutes les clés API d'un même identifiant, peut changer
# silencieusement dès qu'un nouveau compte démo est créé sur la
# plateforme — incident réel du 20/08/2026, voir docs/DECISIONS.md).
# Obligatoire pour run_executor_loop/run_trend_loop (échec net au
# démarrage si absent), inutile pour telegram_listener/control_bot.
CAPITAL_ACCOUNT_ID=

# --- Capital.com (compte démo dédié, Hypothèse #3 — déployée le
#     21/08/2026, voir docs/DECISIONS.md) ---
CAPITAL_API_KEY_HYPOTHESIS3=
CAPITAL_IDENTIFIER_HYPOTHESIS3=   # si vide, repli automatique sur CAPITAL_IDENTIFIER
CAPITAL_API_PASSWORD_HYPOTHESIS3=
CAPITAL_ACCOUNT_ID_HYPOTHESIS3=   # même principe que CAPITAL_ACCOUNT_ID ci-dessus, jamais "préféré"

# --- Capital.com (compte démo dédié, Hypothèse #2 — validée le
#     21/08/2026, voir docs/HYPOTHESES.md ; identifiants dédiés PAS
#     encore fournis à ce jour, voir docs/DECISIONS.md du 21/08/2026 —
#     hypothesis2_executor.py échoue net (ConfigError) tant qu'ils
#     restent vides, aucun repli automatique vers un autre compte) ---
CAPITAL_API_KEY_HYPOTHESIS2=
CAPITAL_IDENTIFIER_HYPOTHESIS2=   # si vide, repli automatique sur CAPITAL_IDENTIFIER
CAPITAL_API_PASSWORD_HYPOTHESIS2=
CAPITAL_ACCOUNT_ID_HYPOTHESIS2=   # même principe que CAPITAL_ACCOUNT_ID ci-dessus, jamais "préféré"

# --- Modèles ---
EXTRACTION_API_KEY=
ANTHROPIC_API_KEY=

# --- Configuration ---
DB_PATH=./data/assistant_trading.db
CONFIDENCE_THRESHOLD=0.75
RISK_PERCENT_DEFAULT=2
RISK_PERCENT_BOOSTED=4
ENVELOPE_INITIAL=500
